# Путь к хранилищу Obsidian (измените на свой)
OBSIDIAN_VAULT_PATH=/home/user/ObsidianVault

# Настройки OpenAI (ограничение модели)
OPENAI_MODEL=gpt-3.5-turbo-16k
OPENAI_API_BASE=https://proxypi.ru/v1

# Настройки сервера
FLASK_APP=app.py
FLASK_ENV=production

# Настройки Telegram-бота
BOT_TOKEN=ваш_токен_бота_от_BotFather
CHAT_ID=ваш_идентификатор_чата
CHECK_INTERVAL=3600  # интервал проверки в секундах (по умолчанию 1 час)