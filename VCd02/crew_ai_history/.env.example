# Настройки LLM
OPENAI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_API_BASE=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL_NAME=gpt-3.5-turbo-16k

# Telegram
BOT_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# LogTail (опционально)
LOGTAIL_SOURCE_TOKEN=ХХХХХХХХХХХХХХХХХХХХХХХХХХХХХХ

# Таймауты и повторные попытки (сек)
LLM_TIMEOUT=600
LLM_MAX_RETRIES=3
RETRY_DELAY=2
RETRY_BACKOFF=2
RETRY_MAX_ATTEMPTS=3

# Кэширование SEO (сек, 86400 = 1 сутки)
SEO_CACHE_TTL=86400

# Максимальная длина произвольного запроса (символов)
MAX_CUSTOM_QUERY_LENGTH=500

# Включить трассировку CrewAI (false по умолчанию)
CREWAI_TELEMETRY_ENABLED=false